---
import { PAGES } from '../site/pages.ts';

// Impressum und Datenschutz von jeder Seite mit einem Klick (Spec AK-1), dazu der Link zum öffentlichen Repo.
const footerPages = PAGES.filter((page) => page.nav === 'footer');
---

<footer class="site-footer">
  <p>© 2026 codeslage</p>
  <ul>
    {footerPages.map((page) => (
      <li>
        <a href={page.path}>{page.label}</a>
      </li>
    ))}
    <li>
      <a href="https://github.com/codeslage/werkstatt">Quellcode auf GitHub</a>
    </li>
  </ul>
</footer>
