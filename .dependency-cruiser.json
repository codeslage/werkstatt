{
  "$schema": "https://raw.githubusercontent.com/sverweij/dependency-cruiser/main/src/schema/configuration.schema.json",
  "forbidden": [
    {
      "name": "no-circular",
      "comment": "Keine zyklischen Imports (Artikel XV).",
      "severity": "error",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "packages-nicht-nach-oben",
      "comment": "Abhängigkeiten zeigen nur von Apps und Tools zu Paketen, nie umgekehrt (Artikel XV, Plan 04-fundament).",
      "severity": "error",
      "from": { "path": "^packages/" },
      "to": { "path": "^(apps|tools|infra)/" }
    }
  ],
  "options": {
    "doNotFollow": { "path": "node_modules" },
    "exclude": { "path": "node_modules" },
    "tsPreCompilationDeps": true
  }
}
