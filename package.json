{
  "name": "codeslage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "vitest run --project unit",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.json --output-type err .",
    "spec-check": "node tools/spec-check/src/cli.ts specs",
    "test:infra": "vitest run --project infra",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@codeslage/config": "workspace:*",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
