{
  "name": "codeslage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "vitest run --project unit",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "knip": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.json --output-type err .",
    "spec-check": "node tools/spec-check/src/cli.ts specs",
    "test:infra": "vitest run --project infra",
    "test:smoke": "vitest run --project smoke",
    "dev:up": "APP_VERSION=$(git rev-parse --short HEAD) docker compose up -d --build --wait",
    "dev:down": "docker compose down",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "spellcheck": "cspell --no-progress --dot ."
  },
  "devDependencies": {
    "@codeslage/config": "workspace:*",
    "@cspell/dict-de-de": "4.1.3",
    "@types/node": "24.19.2",
    "cspell": "10.5.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
