# Vorlage für die lokale .env (Constitution VI): nur Namen, nie echte Werte.
# Kopieren nach .env und dort ausfüllen. Wer welche Rechte hat: docs/secrets.md

# Cloudflare-Konto (kein Secret, aber intern – steht nie im Repo)
CLOUDFLARE_ACCOUNT_ID=
# Token „codeslage-tofu-rw“ (Account API token)
CLOUDFLARE_API_TOKEN=
# Passphrase für die State-Verschlüsselung (mind. 32 Zeichen, auch im Passwortmanager)
TF_ENCRYPTION_PASSPHRASE=
# S3-Zugang zu R2 für den Tofu-State
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2-Endpoint im EU-Rechtsraum: https://<konto-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
